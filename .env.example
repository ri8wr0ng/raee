# Convex CLI runs from the repository root. `vp run dev:cloud` manages .env.local.
# Use the deployment selected by `convex dev`.
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# Optional CLI/MCP overrides. Node scripts do not automatically read .env files.
# Example: node --env-file=.env scripts/raee-cli.mjs --help
# Leave unset to use discovery and the default author.
# RAEE_API_FILE=/absolute/path/to/local-api.json
# RAEE_APP_EXECUTABLE=/absolute/path/to/raE.E.exe
# RAEE_PROJECT=/absolute/path/to/project
# RAEE_AUTHOR=cli
# RAEE_HEADLESS_DIAGNOSTICS=1
